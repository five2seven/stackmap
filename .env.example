# Copy this file to .env.local when environment-specific values are needed.
# Only variables prefixed with VITE_ are exposed to browser code.
VITE_APP_DISPLAY_NAME=StackMap

# Deployment metadata; this value is not exposed to browser code.
# Default: stackmap.rareobjectlabs.app
POC_DOMAIN=stackmap.rareobjectlabs.app

# Optional server-side Portainer HTTPS origin. Leave unset to disable import.
# API tokens are entered in the production UI and must never be stored here.
STACKMAP_PORTAINER_URL=
